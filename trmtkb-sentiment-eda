ues = [role_data[lbl].values[0] if lbl in role_data.columns else 0 for lbl in all_labels]\n","        values += values[:1]\n","        ax.plot(angles_full, values, \"o-\", linewidth=1.5, label=ROLE_LABELS.get(role, role), color=ROLE_COLORS.get(role, \"#999999\"), alpha=0.85)\n","        ax.fill(angles_full, values, alpha=0.08, color=ROLE_COLORS.get(role, \"#999999\"))\n","\n","    ax.set_xticks(angles_full[:-1])\n","    ax.set_xticklabels(all_labels, fontsize=7, rotation=45)\n","    ax.set_ylim(0, 1)\n","    ax.set_title(f\"{target_work} - Full GoEmotions Radar (28 labels)\", fontsize=12, pad=15)\n","    handles, labels = ax.get_legend_handles_labels()\n","    if handles:\n","        ax.legend(loc=\"upper right\", bbox_to_anchor=(1.3, 1.1))\n","    plt.tight_layout()\n","    plt.show()\n","\n","fig, axes = plt.subplots(rows, cols, figsize=(cols * 5, rows * 5))\n","axes = np.array(axes).reshape(-1)\n","\n","for idx, work in enumerate(works):\n","    ax = axes[idx]\n","    sub = summary[summary[\"work\"] == work]\n","    if sub.empty:\n","        ax.axis(\"off\")\n","        continue\n","\n","    pie_data = sub.groupby(\"role_unified\")[\"ratio\"].mean().sort_values(ascending=False)\n","    colors = [ROLE_COLORS.get(role, \"#999999\") for role in pie_data.index]\n","    labels = [ROLE_LABELS.get(role, role) for role in pie_data.index]\n","    ax.pie(pie_data.values, labels=labels, autopct=\"%1.1f%%\", colors=colors, startangle=90)\n","    ax.set_title(f\"{work}\\n(Avg Sentiment Share)\")\n","\n","for idx in range(len(works), len(axes)):\n","    axes[idx].axis(\"off\")\n","\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"9fe00a98","metadata":{"papermill":{"duration":0.022818,"end_time":"2026-06-25T05:01:02.388493+00:00","exception":false,"start_time":"2026-06-25T05:01:02.365675+00:00","status":"completed"},"tags":[]},"source":["## 5. Stacked bars by emotion\n","Emotion-first stacked bar views for comparing how each emotion is distributed across t