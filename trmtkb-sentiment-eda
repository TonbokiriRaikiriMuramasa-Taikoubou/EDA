\"nervous\", \"optimism\",\n","    \"pride\", \"realization\", \"relief\", \"remorse\", \"sadness\", \"surprise\", \"neutral\"\n","]\n","\n","PRIMARY_EMOTIONS = [\n","    \"joy\", \"sadness\", \"anger\", \"fear\", \"surprise\",\n","    \"disgust\", \"neutral\", \"excitement\", \"love\", \"admiration\"\n","]\n","\n","ROLE_ORDER = [\"user\", \"assistant_a\", \"assistant_b\", \"unknown\"]\n","ROLE_LABELS = {\n","    \"user\": \"user\",\n","    \"assistant_a\": \"AI1\",\n","    \"assistant_b\": \"AI2\",\n","    \"unknown\": \"unknown\",\n","}\n","ROLE_COLORS = {\n","    \"user\": \"#2196F3\",\n","    \"assistant_a\": \"#FF9800\",\n","    \"assistant_b\": \"#9C27B0\",\n","    \"unknown\": \"#9E9E9E\",\n","}\n","\n","# 発表向け: 感情ごとの色\n","EMOTION_COLORS = {\n","    # admiration を主役に\n","    \"admiration\": \"#FF4FA3\",\n","    \"love\": \"#FF7EB6\",\n","    \"gratitude\": \"#FFB347\",\n","    \"approval\": \"#FF8C69\",\n","    \"caring\": \"#F497B6\",\n","    \"optimism\": \"#FFA94D\",\n","    \"pride\": \"#D96CFF\",\n","    \"relief\": \"#FFD166\",\n","    \"desire\": \"#F78FB3\",\n","\n","    # laugh / bright\n","    \"joy\": \"#FFD93D\",\n","    \"amusement\": \"#FFC300\",\n","    \"excitement\": \"#FF9F1C\",\n","\n","    # sad / cold\n","    \"sadness\": \"#4D96FF\",\n","    \"grief\": \"#355CDE\",\n","    \"remorse\": \"#6C8AE4\",\n","    \"disappointment\": \"#6FA8DC\",\n","    \"fear\": \"#5B7CFA\",\n","\n","    # question / gray\n","    \"confusion\": \"#7A7A7A\",\n","    \"neutral\": \"#BDBDBD\",\n","    \"nervous\": \"#8D99AE\",\n","    \"realization\": \"#95A5A6\",\n","    \"embarrassment\": \"#A1887F\",\n","\n","    # rare / green\n","    \"curiosity\": \"#2ECC71\",\n","    \"surprise\": \"#20C997\",\n","\n","    # strong negative\n","    \"anger\": \"#E63946\",\n","    \"annoyance\": \"#C44536\",\n","    \"disapproval\": \"#8E44AD\",\n","    \"disgust\": \"#2E8B57\",\n","}\n","\n","print(\"Config loaded.\")\n","print(f\"MODEL_NAME={MODEL_NAME}\")\n","print(f\"MAX_SAMPLES_PER_WORK={MAX_SAMPLES_PER_WORK}\")\n","print(f\"BATCH_SIZE={BATCH_SIZE}\")\n","print(f\"MAX_NEW_TOKENS={MAX_NEW_TOKENS}\")\n"]},{"cell_type":"markdown","id":"14db1272","metadata":{"papermill":{"duration":0.004207,"end_time":"2026-06-25T04:58:29.294341+00:00","exception":false,"start_time":"2026-06-25T04:58:29.290134+00:00","status":"completed"},"tags":[]},"source":["## 2. Load model and infer emotions\n","Load Gemma, parse JSON dialogue sessions, and infer GoEmotions labels."]},{"cell_type":"code","execution_count":5,"id":"d9393224","metadata":{"execution":{"iopub.execute_input":"2026-06-25T04:58:29.305088Z","iopub.status.busy":"2026-06-25T04:58:29.304302Z","iopub.status.idle":"2026-06-25T04:58:29.330338Z","shell.execute_reply":"2026-06-25T04:58:29.329227Z"},"papermill":{"duration":0.033421,"end_time":"2026-06-25T04:58:29.33196+00:00","exception":false,"start_time":"2026-06-25T04:58:29.298539+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Helpers loaded.\n"]}],"source":["\n","# ==================== CELL 3: helper functions ====================\n","def normalize_text(text: str) -> str:\n","    text = str(text).replace(\"\\r\", \" \").replace(\"\\n\", \" \")\n","    text = re.sub(r\"\\s+\", \" \", text).strip()\n","    return text[:MAX_INPUT_CHARS]\n","\n","\n","def unify_role(msg: Dict) -> str:\n","    candidates = [\n","        msg.get(\"speaker\", \"\"),\n","        msg.get(\"name\", \"\"),\n","        msg.get(\"model\", \"\"),\n","        msg.get(\"role\", \"\"),\n","        msg.get(\"author\", \"\"),\n","    ]\n","    joined = \" | \".join([str(x).lower().strip() for x in candidates if x is not None])\n","\n","    if \"user\" in joined or \"作者\" in joined:\n","        return \"user\"\n","    if \"assistant_a\" in joined or \"assistant a\" in joined or re.search(r\"(^|\\W)a(\\W|$)\", joined):\n","        return \"assistant_a\"\n","    if \"assistant_b\" in joined or \"assistant b\" in joined or re.search(r\"(^|\\W)b(\\W|$)\", joined):\n","        return \"assistant_b\"\n","    return \"unknown\"\n","\n","\n","def extract_content(msg: Dict) -> str:\n","    for key in [\"content\", \"text\", \"body\", \"message\", \"value\"]:\n","        value = msg.get(key, \"\")\n","        if value and str(value).strip():\n","            return str(value)\n","    return \"\"\n","\n","\n","def load_session_json(json_path: str) -> pd.DataFrame:\n","    with open(json_path, \"r\", encoding=\"utf-8\") as f:\n","        data = json.load(f)\n","\n","    if isinstance(data, list):\n","        messages = data\n","    elif isinstance(data, dict):\n","        if isinstance(data.get(\"turns\"), list):\n","            messages = data[\"turns\"]\n","        elif isinstance(data.get(\"messages\"), list):\n","            messages = data[\"messages\"]\n","        elif isinstance(data.get(\"conversation\"), list):\n","            messages = data[\"conversation\"]\n","        else:\n","            return pd.DataFrame()\n","    else:\n","        return pd.DataFrame()\n","\n","    rows = []\n","    for msg in messages:\n","        if not isinstance(msg, dict):\n","            continue\n","\n","        content = extract_content(msg)\n","        if not content.strip():\n","            continue\n","\n","        rows.append({\n","            \"role_unified\": unify_role(msg),\n","            \"speaker\": str(msg.get(\"speaker\", msg.get(\"name\", msg.get(\"model\", msg.get(\"role\", \"\"))))),\n","            \"content\": content,\n","        })\n","\n","    return pd.DataFrame(rows)\n","\n","\n","def build_prompt(text: str) -> str:\n","    clean = normalize_text(text)\n","    labels_text = \", \".join(GOEMOTIONS_LABELS)\n","    return f\"\"\"あなたは感情分析器です。\n","次の文章の感情を、GoEmotionsラベル一覧から1〜3個選んでください。\n","該当が弱い場合は neutral を選んでください。\n","\n","重要:\n","- 返答はラベル名だけ\n","- 半角カンマ区切り\n","- 説明文・理由・見出し・記号は禁止\n","- 使ってよいラベルは一覧の中だけ\n","\n","ラベル一覧:\n","{labels_text}\n","\n","文章:\n","{clean}\n","\n","回答:\"\"\"\n","\n","\n","def parse_emotions(output_text: str) -> List[str]:\n","    if not output_text:\n","        return [\"neutral\"]\n","\n","    text = str(output_text).lower().strip().replace(\"**\", \" \")\n","\n","    for stop_word in [\"explanation\", \"理由\", \"説明\", \"note:\", \"answer:\"]:\n","        if stop_word in text:\n","            text = text.split(stop_word)[0]\n","\n","    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]\n","    head = \" \".join(lines[:2]) if lines else text\n","\n","    parts = re.split(r\"[,/;\\n]+\", head)\n","    labels = []\n","    for p in parts:\n","        p = re.sub(r\"[^a-z_]\", \"\", p.strip())\n","        if p in GOEMOTIONS_LABELS and p not in labels:\n","            labels.append(p)\n","\n","    if not labels:\n","        for lbl in GOEMOTIONS_LABELS:\n","            if re.search(rf\"\\b{re.escape(lbl)}\\b\", head):\n","                labels.append(lbl)\n","\n","    return labels if labels else [\"neutral\"]\n","\n","\n","def load_hf_token():\n","    try:\n","        from kaggle_secrets import UserSecretsClient\n","        user_secrets = UserSecretsClient()\n","        hf_token = user_secrets.get_secret(\"HF_TOKEN\")\n","        os.environ[\"HF_TOKEN\"] = hf_token\n","        print(\"HF_TOKEN loaded from Kaggle Secrets.\")\n","        return hf_token\n","    except Exception as e:\n","        print(f\"Warning: {e}\")\n","        return os.environ.get(\"HF_TOKEN\", None)\n","\n","\n","def choose_dtype():\n","    return torch.float16 if torch.cuda.is_available() else torch.float32\n","\n","\n","def load_model_and_tokenizer(model_name: str, hf_token: str = None):\n","    print(f\"Loading Gemma: {model_name}\")\n","    tokenizer = AutoTokenizer.from_pretrained(model_name, token=hf_token)\n","    if tokenizer.pad_token_id is None:\n","        tokenizer.pad_token = tokenizer.eos_token\n","    tokenizer.padding_side = \"left\"\n","\n","    model = AutoModelForCausalLM.from_pretrained(\n","        model_name,\n","        token=hf_token,\n","        dtype=choose_dtype(),\n","        device_map=\"auto\",\n","    )\n","    model.eval()\n","\n","    model.generation_config.pad_token_id = tokenizer.pad_token_id\n","    model.generation_config.eos_token_id = tokenizer.eos_token_id\n","    try:\n","        model.generation_config.max_length = None\n","    except Exception:\n","        pass\n","\n","    return tokenizer, model\n","\n","\n","def generate_batch(prompts: List[str], tokenizer, model) -> List[str]:\n","    if not prompts:\n","        return []\n","\n","    input_device = next(model.parameters()).device\n","    encoded = tokenizer(\n","        prompts,\n","        return_tensors=\"pt\",\n","        padding=True,\n","        truncation=True,\n","        max_length=1024,\n","    )\n","    encoded = {k: v.to(input_device) for k, v in encoded.items()}\n","\n","    with torch.inference_mode():\n","        outputs = model.generate(\n","            **encoded,\n","            max_new_tokens=MAX_NEW_TOKENS,\n","            do_sample=False,\n","            pad_token_id=tokenizer.pad_token_id,\n","            eos_token_id=tokenizer.eos_token_id,\n","            use_cache=True,\n","        )\n","\n","    prompt_len = encoded[\"input_ids\"].shape[1]\n","    generated_only = outputs[:, prompt_len:]\n","    texts = tokenizer.batch_decode(generated_only, skip_special_tokens=True)\n","    return texts\n","\n","\n","def infer_emotions_for_df(df: pd.DataFrame, work_name: str, tokenizer, model) -> List[Dict]:\n","    records = []\n","    texts = df[\"content\"].astype(str).tolist()\n","    roles = df[\"role_unified\"].astype(str).tolist()\n","    prompts = [build_prompt(t) for t in texts]\n","\n","    total = len(prompts)\n","    for start in range(0, total, BATCH_SIZE):\n","        end = min(start + BATCH_SIZE, total)\n","        batch_prompts = prompts[start:end]\n","        batch_roles = roles[start:end]\n","\n","        try:\n","            batch_outputs = generate_batch(batch_prompts, tokenizer, model)\n","        except Exception as e:\n","            print(f\"    → バッチ推論エラー ({start}:{end}): {e}\")\n","            batch_outputs = [\"neutral\"] * len(batch_prompts)\n","\n","        for role, raw_output in zip(batch_roles, batch_outputs):\n","            labels = parse_emotions(raw_output)\n","            for lbl in labels:\n","                records.append({\n","                    \"work\": work_name,\n","                    \"role_unified\": role,\n","                    \"label\": lbl,\n","                    \"raw_output\": str(raw_output)[:120],\n","                })\n","\n","        print(f\"    - batch {start + 1:>3}-{end:<3} / {total}\")\n","\n","    return records\n","\n","print(\"Helpers loaded.\")"]},{"cell_type":"markdown","id":"50aa903b","metadata":{"papermill":{"duration":0.00407,"end_time":"2026-06-25T04:58:29.340502+00:00","exception":false,"start_time":"2026-06-25T04:58:29.336432+00:00","status":"completed"},"tags":[]},"source":["## 3. Save CSV outputs\n","Save detailed and summarized outputs for fast re-plotting."]},{"cell_type":"code","execution_count":6,"id":"4023b0e6","metadata":{"execution":{"iopub.execute_input":"2026-06-25T04:58:29.350789Z","iopub.status.busy":"2026-06-25T04:58:29.350079Z","iopub.status.idle":"2026-06-25T05:00:58.39438Z","shell.execute_reply":"2026-06-25T05:00:58.392998Z"},"papermill":{"duration":149.051925,"end_time":"2026-06-25T05:00:58.396465+00:00","exception":false,"start_time":"2026-06-25T04:58:29.34454+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["HF_TOKEN loaded from Kaggle Secrets.\n","Loading Gemma: google/gemma-2-2b-jpn-it\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"ed62f4f8a64e4e4f843c835bffefeb21","version_major":2,"version_minor":0},"text/plain":["config.json:   0%|          | 0.00/805 [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"554dc2d3b4f047ec