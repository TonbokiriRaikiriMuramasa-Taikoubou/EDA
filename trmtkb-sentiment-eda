nt_table[\"_sum_\"] = count_table.sum(axis=1)\n","\n","    if SORT_MODE == \"label\":\n","        ordered_labels = [lbl for lbl in GOEMOTIONS_LABELS if lbl in count_table.index]\n","        count_table = count_table.loc[ordered_labels]\n","    else:\n","        count_table = count_table.sort_values(\"_sum_\", ascending=False)\n","\n","    if TOP_N_EMOTIONS is not None:\n","        count_table = count_table.head(TOP_N_EMOTIONS)\n","\n","    totals = count_table[\"_sum_\"].copy()\n","    count_table = count_table.drop(columns=[\"_sum_\"])\n","    pct_table = count_table.div(totals, axis=0) * 100\n","\n","    return count_table, pct_table\n","\n","\n","def plot_one_work_pair(ax_pct, ax_cnt, work_name, count_table, pct_table):\n","    labels = count_table.index.tolist()\n","    x = np.arange(len(labels))\n","\n","    bottom_pct = np.zeros(len(labels))\n","    bottom_cnt = np.zeros(len(labels))\n","\n","    for role in ROLE_ORDER:\n","        pct_vals = pct_table[role].values if role in pct_table.columns else np.zeros(len(labels))\n","        cnt_vals = count_table[role].values if role in count_table.columns else np.zeros(len(labels))\n","\n","        if np.sum(pct_vals) == 0 and np.sum(cnt_vals) == 0:\n","            continue\n","\n","        colors = [EMOTION_COLORS.get(lbl, \"#BBBBBB\") for lbl in labels]\n","        hatch = ROLE_HATCHES.get(role, \"\")\n","\n","        ax_pct.bar(\n","            x,\n","            pct_vals,\n","            bottom=bottom_pct,\n","            width=BAR_WIDTH,\n","            color=colors,\n","            hatch=hatch,\n","            edgecolor=EDGE_COLOR,\n","            linewidth=LINE_WIDTH,\n","            label=ROLE_LABELS.get(role, role),\n","        )\n","        ax_cnt.bar(\n","            x,\n","            cnt_vals,\n","            bottom=bottom_cnt,\n","            width=BAR_WIDTH,\n","            color=colors,\n","            hatch=hatch,\n","            edgecolor=EDGE_COLOR,\n","            linewidth=LINE_WIDTH,\n","            label=ROLE_LABELS.get(role, role),\n","        )\n","\n","        bottom_pct += pct_vals\n","        bottom_cnt += cnt_vals\n","\n","    ax_pct.set_title(f\"{work_name} | 100% stacked by emotion\", fontsize=TITLE_SIZE)\n","    ax_pct.set_xticks(x)\n","    ax_pct.set_xticklabels(\n","        labels,\n","        rotation=ROTATION,\n","        ha=\"right\",\n","        fontsize=X_LABEL_SIZE,\n","        fontstyle=\"italic\",\n","    )\n","    ax_pct.set_ylabel(\"%\", fontsize=AXIS_LABEL_SIZE)\n","    ax_pct.set_ylim(0, 100)\n","    ax_pct.yaxis.set_major_formatter(mtick.PercentFormatter())\n","    ax_pct.grid(axis=\"y\", alpha=0.3)\n","    ax_pct.tick_params(axis=\"x\", pad=10)\n","    ax_pct.tick_params(axis=\"y\", labelsize=Y_TICK_SIZE)\n","\n","    ax_cnt.set_title(f\"{work_name} | stacked counts by emotion\", fontsize=TITLE_SIZE)\n","    ax_cnt.set_xticks(x)\n","    ax_cnt.set_xticklabels(\n","        labels,\n","        rotation=ROTATION,\n","        ha=\"right\",\n","        fontsize=X_LABEL_SIZE,\n","        fontstyle=\"italic\",\n","    )\n","    ax_cnt.set_ylabel(\"count\", fontsize=AXIS_LABEL_SIZE)\n","    ax_cnt.grid(axis=\"y\", alpha=0.3)\n","    ax_cnt.tick_params(axis=\"x\", pad=10)\n","    ax_cnt.tick_params(axis=\"y\", labelsize=Y_TICK_SIZE)\n","\n","\n","works = summary[\"work\"].dropna().unique().tolist()\n","print(f\"Works: {len(works)}\")\n","\n","for start in range(0, len(works), WORKS_PER_FIG):\n","    chunk = works[start:start + WORKS_PER_FIG]\n","    nrows = len(chunk)\n","\n","    fig, axes = plt.subplots(\n","        nrows=nrows,\n","        ncols=2,\n","        figsize=(FIG_WIDTH, ROW_HEIGHT * nrows),\n","        constrained_layout=True,\n","    )\n","\n","    if nrows == 1:\n","        axes = np.array([axes])\n","\n","    for row_idx, work_name in enumerate(chunk):\n","        ax_pct = axes[row_idx, 0]\n","        ax_cnt = axes[row_idx, 1]\n","\n","        count_table, pct_table = prepare_work_tables(summary, work_name)\n","        if count_table is None or pct_table is None or count_table.empty:\n","            ax_pct.axis(\"off\")\n","            ax_cnt.axis(\"off\")\n","            continue\n","\n","        plot_one_work_pair(ax_pct, ax_cnt, work_name, count_table, pct_table)\n","\n","    role_legend_handles = [\n","        Patch(\n","            facecolor=\"white\",\n","            edgecolor=EDGE_COLOR,\n","            hatch=ROLE_HATCHES.get(role, \"\"),\n","            label=ROLE_LABELS.get(role, role),\n","            linewidth=LINE_WIDTH,\n","        )\n","        for role in ROLE_ORDER\n","        if role in summary[\"role_unified\"].unique()\n","    ]\n","\n","    fig.legend(\n","        handles=role_legend_handles,\n","        loc=\"upper center\",\n","        ncol=min(len(role_legend_handles), 4),\n","        bbox_to_anchor=(0.5, 1.02),\n","        frameon=True,\n","        fontsize=LEGEND_SIZE,\n","        title=\"Role pattern\",\n","        title_fontsize=LEGEND_SIZE,\n","    )\n","\n","    fig.suptitle(\n","        f\"GoEmotions Stacked Bar Charts ({start + 1}-{start + len(chunk)} Opus)\",\n","        fontsize=SUPTITLE_SIZE,\n","        y=1.03,\n","    )\n","    plt.show()\n","\n","print(\"=== stacked bar by emotion (emotion palette variant) done ===\")"]},{"cell_type":"markdown","id":"cf547e60","metadata":{"papermill":{"duration":0.089534,"end_time":"2026-06-25T05:01:16.669606+00:00","exception":false,"start_time":"2026-06-25T05:01:16.580072+00:00","status":"completed"},"tags":[]},"source":["## 6. Role-centric stacked bars\n","Single-opus full-emotion view.\n","A one-work-per-figure layout that shows all emotions appearing in each work.\n","\n","This version is especially useful for emotion-rich sessions."]},{"cell_type":"code","execution_count":11,"id":"16637291","metadata":{"execution":{"iopub.execute_input":"2026-06-25T05:01:16.838511Z","iopub.status.busy":"2026-06-25T05:01:16.837906Z","iopub.status.idle":"2026-06-25T05:01:22.717292Z","shell.execute_reply":"2026-06-25T05:01:22.716261Z"},"papermill":{"duration":5.968868,"end_time":"2026-06-25T05:01:22.721998+00:00","exception":false,"start_time":"2026-06-25T05:01:16.75313+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["WORKS_PER_FIG=1\n","TOP_N_EMOTIONS=None\n","PLOT_ZERO_EMOTIONS=False\n","SORT_MODE=count\n","Works: 8\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 3360x1792 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 3360x1792 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 3360x1792 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 3360x1792 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 3360x1792 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 3360x1792 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 3360x1792 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 3360x1792 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["=== CELL 7 final single-opus view done ===\n"]}],"source":["# ==================== CELL 7 FINAL: one opus per figure + all appeared emotions ====================\n","# 目的:\n","# - 1作品ずつ個別表示\n","# - その作品で出現した感情をすべて表示（0は出さない）\n","# - legend を上に逃がして、被りを減らす\n","# - 文字サイズを少し大きくして見やすくする\n","#\n","# 前提:\n","# - CELL 2 実行済み\n","# - SUMMARY_CSV, GOEMOTIONS_LABELS, ROLE_LABELS が定義済み\n","# - EMOTION_COLORS が定義済み（未定義でも fallback あり）\n","\n","summary = pd.read_csv(SUMMARY_CSV)\n","\n","WORKS_PER_FIG = 1\n","TOP_N_EMOTIONS = None          # 全出現感情を出す。上位15に戻すなら 15\n","PLOT_ZERO_EMOTIONS = False     # 0感情は表示しない\n","SORT_MODE = \"count\"           # \"count\" or \"label\"\n","FIG_WIDTH = 24\n","FIG_HEIGHT = 12.8\n","ROLE_TICK_SIZE = 20\n","Y_TICK_SIZE = 14\n","TITLE_SIZE = 30\n","AXIS_LABEL_SIZE = 17\n","LEGEND_SIZE = 20\n","SUPTITLE_SIZE = 22\n","BASE_ROLE_ORDER = [\"user\", \"assistant_a\", \"assistant_b\"]\n","LEGEND_NCOL = 4\n","LEGEND_Y = 0.965\n","TIGHT_RECT_TOP = 0.84\n","\n","print(f\"WORKS_PER_FIG={WORKS_PER_FIG}\")\n","print(f\"TOP_N_EMOTIONS={TOP_N_EMOTIONS}\")\n","print(f\"PLOT_ZERO_EMOTIONS={PLOT_ZERO_EMOTIONS}\")\n","print(f\"SORT_MODE={SORT_MODE}\")\n","\n","\n","def prepare_role_layout_tables(summary_df, work_name):\n","    sub = summary_df[summary_df[\"work\"] == work_name].copy()\n","    if sub.empty:\n","        return None, None, None, None\n","\n","    count_table = sub.pivot_table(\n","        index=\"role_unified\",\n","        columns=\"label\",\n","        values=\"count\",\n","        aggfunc=\"sum\",\n","        fill_value=0,\n","    )\n","\n","    role_order = [r for r in BASE_ROLE_ORDER if r in count_table.index]\n","    if \"unknown\" in count_table.index and count_table.loc[\"unknown\"].sum() > 0:\n","        role_order.append(\"unknown\")\n","\n","    if not role_order:\n","        return None, None, None, None\n","\n","    count_table = count_table.loc[role_order]\n","\n","    if PLOT_ZERO_EMOTIONS:\n","        count_table = count_table.reindex(columns=GOEMOTIONS_LABELS, fill_value=0)\n","    else:\n","        count_table = count_table.loc[:, count_table.sum(axis=0) > 0]\n","\n","    if count_table.empty:\n","        return None, None, None, None\n","\n","    emotion_totals = count_table.sum(axis=0)\n","\n","    if SORT_MODE == \"label\":\n","        selected_emotions = [lbl for lbl in GOEMOTIONS_LABELS if lbl in emotion_totals.index]\n","    else:\n","        selected_emotions = emotion_totals.sort_values(ascending=False).index.tolist()\n","\n","    if TOP_N_EMOTIONS is not None:\n","        selected_emotions = selected_emotions[:TOP_N_EMOTIONS]\n","\n","    count_table = count_table[selected_emotions]\n","\n","    row_sums = count_table.sum(axis=1).replace(0, np.nan)\n","    pct_table = count_table.div(row_sums, axis=0).fillna(0) * 100\n","\n","    fallback = plt.get_cmap(\"tab20\")\n","    color_map = {}\n","    for i, emo in enumerate(selected_emotions):\n","        color_map[emo] = EMOTION_COLORS.get(emo, fallback(i % 20))\n","\n","    return count_table, pct_table, role_order, color_map\n","\n","\n","def plot_role_layout_pair(ax_pct, ax_cnt, work_name, count_table, pct_table, role_order, color_map):\n","    labels = [ROLE_LABELS.get(r, r) for r in role_order]\n","    x = np.arange(len(role_order))\n","\n","    bottom_pct = np.zeros(len(role_order))\n","    bottom_cnt = np.zeros(len(role_order))\n","\n","    for emotion in count_table.columns:\n","        pct_vals = pct_table[emotion].values\n","        cnt_vals = count_table[emotion].values\n","        color = color_map.get(emotion, \"#999999\")\n","\n","        ax_pct.bar(x, pct_vals, bottom=bottom_pct, width=0.72, color=color, label=emotion)\n","        ax_cnt.bar(x, cnt_vals, bottom=bottom_cnt, width=0.72, color=color, label=emotion)\n","\n","        bottom_pct += pct_vals\n","        bottom_cnt += cnt_vals\n","\n","    ax_pct.set_title(f\"{work_name} | 100% stacked by role\", fontsize=TITLE_SIZE, pad=14)\n","    ax_pct.set_xticks(x)\n","    ax_pct.set_xticklabels(labels, fontsize=ROLE_TICK_SIZE)\n","    ax_pct.set_ylabel(\"%\", fontsize=AXIS_LABEL_SIZE)\n","    ax_pct.set_ylim(0, 100)\n","    ax_pct.yaxis.set_major_formatter(mtick.PercentFormatter())\n","    ax_pct.grid(axis=\"y\", alpha=0.3)\n","    ax_pct.tick_params(axis=\"y\", labelsize=Y_TICK_SIZE)\n","\n","    ax_cnt.set_title(f\"{work_name} | stacked counts by role\", fontsize=TITLE_SIZE, pad=14)\n","    ax_cnt.set_xticks(x)\n","    ax_cnt.set_xticklabels(labels, fontsize=ROLE_TICK_SIZE)\n","    ax_cnt.set_ylabel(\"count\", fontsize=AXIS_LABEL_SIZE)\n","    ax_cnt.grid(axis=\"y\", alpha=0.3)\n","    ax_cnt.tick_params(axis=\"y\", labelsize=Y_TICK_SIZE)\n","\n","\n","works = summary[\"work\"].dropna().unique().tolist()\n","print(f\"Works: {len(works)}\")\n","\n","for work_name in works:\n","    count_table, pct_table, role_order, color_map = prepare_role_layout_tables(summary, work_name)\n","    if count_table is None or pct_table is None:\n","        print(f\"skip: {work_name}\")\n","        continue\n","\n","    fig, axes = plt.subplots(\n","        nrows=1,\n","        ncols=2,\n","        figsize=(FIG_WIDTH, FIG_HEIGHT),\n","        constrained_layout=False,\n","    )\n","\n","    ax_pct, ax_cnt = axes[0], axes[1]\n","    plot_role_layout_pair(ax_pct, ax_cnt, work_name, count_table, pct_table, role_order, color_map)\n","\n","    legend_handles, legend_labels = ax_pct.get_legend_handles_labels()\n","    if legend_handles:\n","        fig.legend(\n","            legend_handles,\n","            legend_labels,\n","            loc=\"upper center\",\n","            ncol=LEGEND_NCOL,\n","            bbox_to_anchor=(0.5, LEGEND_Y),\n","            frameon=True,\n","            fontsize=LEGEND_SIZE,\n","        )\n","\n","    fig.suptitle(\n","        f\"GoEmotions Role-Centric Stacked Bars ({work_name})\",\n","        fontsize=SUPTITLE_SIZE,\n","        y=0.995,\n","    )\n","\n","    plt.tight_layout(rect=[0, 0, 1, TIGHT_RECT_TOP])\n","    plt.show()\n","\n","print(\"=== CELL 7 final single-opus view done ===\")"]},{"cell_type":"markdown","id":"2e4ef2aa","metadata":{"papermill":{"duration":0.101749,"end_time":"2026-06-25T05:01:22.931099+00:00","exception":false,"start_time":"2026-06-25T05:01:22.82935+00:00","status":"completed"},"tags":[]},"source":["## 7. Quick tuning notes\n","Small adjustments for readability, layout, legend spacing, and figure scale."]},{"cell_type":"code","execution_count":12,"id":"6718900d","metadata":{"execution":{"iopub.execute_input":"2026-06-25T05:01:23.118053Z","iopub.status.busy":"2026-06-25T05:01:23.116871Z","iopub.status.idle"