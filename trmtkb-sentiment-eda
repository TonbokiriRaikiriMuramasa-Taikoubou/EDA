\n","\n","    if TOP_N_EMOTIONS is not None:\n","        count_table = count_table.head(TOP_N_EMOTIONS)\n","\n","    totals = count_table[\"_sum_\"].copy()\n","    count_table = count_table.drop(columns=[\"_sum_\"])\n","    pct_table = count_table.div(totals, axis=0) * 100\n","\n","    return count_table, pct_table\n","\n","\n","def plot_one_work_pair(ax_pct, ax_cnt, work_name, count_table, pct_table):\n","    labels = count_table.index.tolist()\n","    x = np.arange(len(labels))\n","\n","    bottom_pct = np.zeros(len(labels))\n","    bottom_cnt = np.zeros(len(labels))\n","\n","    for role in ROLE_ORDER:\n","        pct_vals = pct_table[role].values if role in pct_table.columns else np.zeros(len(labels))\n","        cnt_vals = count_table[role].values if role in count_table.columns else np.zeros(len(labels))\n","\n","        if np.sum(pct_vals) == 0 and np.sum(cnt_vals) == 0:\n","            continue\n","\n","        ax_pct.bar(\n","            x, pct_vals, bottom=bottom_pct, width=BAR_WIDTH,\n","            color=ROLE_COLORS.get(role, \"#999999\"), label=ROLE_LABELS.get(role, role)\n","        )\n","        ax_cnt.bar(\n","            x, cnt_vals, bottom=bottom_cnt, width=BAR_WIDTH,\n","            color=ROLE_COLORS.get(role, \"#999999\"), label=ROLE_LABELS.get(role, role)\n","        )\n","\n","        bottom_pct += pct_vals\n","        bottom_cnt += cnt_vals\n","\n","    ax_pct.set_title(f\"{work_name} | 100% stacked by emotion\", fontsize=TITLE_SIZE)\n","    ax_pct.set_xticks(x)\n","    ax_pct.set_xticklabels(\n","        labels,\n","        rotation=ROTATION,\n","        ha=\"right\",\n","        fontsize=X_LABEL_SIZE,\n","        fontstyle=\"italic\",\n","    )\n","    ax_pct.set_ylabel(\"%\", fontsize=AXIS_LABEL_SIZE)\n","    ax_pct.set_ylim(0, 100)\n","    ax_pct.yaxis.set_major_formatter(mtick.PercentFormatter())\n","    ax_pct.grid(axis=\"y\", alpha=0.3)\n","    ax_pct.tick_params(axis=\"x\", pad=10)\n","    ax_pct.tick_params(axis=\"y\", labelsize=Y_TICK_SIZE)\n","\n","    ax_cnt.set_title(f\"{work_name} | stacked counts by emotion\", fontsize=TITLE_SIZE)\n","    ax_cnt.set_xticks(x)\n","    ax_cnt.set_xticklabels(\n","        labels,\n","        rotation=ROTATION,\n","        ha=\"right\",\n","        fontsize=X_LABEL_SIZE,\n","        fontstyle=\"italic\",\n","    )\n","    ax_cnt.set_ylabel(\"count\", fontsize=AXIS_LABEL_SIZE)\n","    ax_cnt.grid(axis=\"y\", alpha=0.3)\n","    ax_cnt.tick_params(axis=\"x\", pad=10)\n","    ax_cnt.tick_params(axis=\"y\", labelsize=Y_TICK_SIZE)\n","\n","\n","works = summary[\"work\"].dropna().unique().tolist()\n","print(f\"Works: {len(works)}\")\n","\n","for start in range(0, len(works), WORKS_PER_FIG):\n","    chunk = works[start:start + WORKS_PER_FIG]\n","    nrows = len(chunk)\n","\n","    fig, axes = plt.subplots(\n","        nrows=nrows,\n","        ncols=2,\n","        figsize=(FIG_WIDTH, ROW_HEIGHT * nrows),\n","        constrained_layout=True,\n","    )\n","\n","    if nrows == 1:\n","        axes = np.array([axes])\n","\n","    legend_handles = None\n","    legend_labels = None\n","\n","    for row_idx, work_name in enumerate(chunk):\n","        ax_pct = axes[row_idx, 0]\n","        ax_cnt = axes[row_idx, 1]\n","\n","        count_table, pct_table = prepare_work_tables(summary, work_name)\n","        if count_table is None or pct_table is None or count_table.empty:\n","            ax_pct.axis(\"off\")\n","            ax_cnt.axis(\"off\")\n","            continue\n","\n","        plot_one_work_pair(ax_pct, ax_cnt, work_name, count_table, pct_table)\n","\n","        if legend_handles is None:\n","            legend_handles, legend_labels = ax_pct.get_legend_handles_labels()\n","\n","    if legend_handles:\n","        fig.legend(\n","            legend_handles,\n","            legend_labels,\n","            loc=\"upper center\",\n","            ncol=min(len(legend_labels), 4),\n","            bbox_to_anchor=(0.5, 1.02),\n","            frameon=True,\n","            fontsize=