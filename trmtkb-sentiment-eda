n","        ax.plot(angles, values, \"o-\", linewidth=2, label=ROLE_LABELS.get(role, role), color=ROLE_COLORS.get(role, \"#999999\"))\n","        ax.fill(angles, values, alpha=0.12, color=ROLE_COLORS.get(role, \"#999999\"))\n","\n","    ax.set_xticks(angles[:-1])\n","    ax.set_xticklabels(PRIMARY_EMOTIONS, fontsize=9)\n","    ax.set_ylim(0, 1)\n","    ax.set_title(work, fontsize=11, pad=15)\n","\n","    handles, labels = ax.get_legend_handles_labels()\n","    if handles:\n","        ax.legend(loc=\"upper right\", bbox_to_anchor=(1.3, 1.1), fontsize=8)\n","\n","for idx in range(len(works), len(axes)):\n","    axes[idx].axis(\"off\")\n","\n","plt.suptitle(\"GoEmotions Primary Emotions Radar (Gemma 2B)\", fontsize=14, y=1.02)\n","plt.tight_layout()\n","plt.show()\n","\n","if len(works) > 0:\n","    target_work = works[0]\n","    full_pivot = summary.pivot_table(\n","        index=[\"work\", \"role_unified\"],\n","        columns=\"label\",\n","        values=\"ratio\",\n","        fill_value=0,\n","    ).reset_index()\n","\n","    sub = full_pivot[full_pivot[\"work\"] == target_work]\n","    all_labels = sorted([c for c in full_pivot.columns if c not in (\"work\", \"role_unified\")])\n","    angles_full = np.linspace(0, 2 * np.pi, len(all_labels), endpoint=False).tolist()\n","    angles_full += angles_full[:1]\n","\n","    fig, ax = plt.subplots(figsize=(10, 10), subplot_kw=dict(polar=True))\n","\n","    for role in ROLE_ORDER:\n","        role_data = sub[sub[\"role_unified\"] == role]\n","        if role_data.empty:\n","            continue\n","\n","        values = [role_data[lbl].values[0] if lbl in role_data.columns else 0 for lbl in all_labels]\n","        values += values[:1]\n","        ax.plot(angles_full, values, \"o-\", linewidth=1.5, label=ROLE_LABELS.get(role, role), color=ROLE_COLORS.get(role, \"#999999\"), alpha=0.85)\n","        ax.fill(angles_full, values, alpha=0.08, color=ROLE_COLORS.get(role, \"#999999\"))\n","\n","    ax.set_xticks(angles_full[:-1]